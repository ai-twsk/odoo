from odoo import models, fields, api, _
from odoo.exceptions import UserError
import logging
import os

_logger = logging.getLogger(__name__)

class GeminiConfiguration(models.TransientModel):
    _name = 'gemini.configuration'
    _description = 'Gemini API Configuration'

    # 将 API Key 存储在系统参数中，并使用 Char 字段配合 store=False 进行输入
    gemini_api_key = fields.Char(
        string="Gemini API Key", 
        help="Paste your Google Gemini API Key here.",
        store=False
    )
    
    # 辅助字段，用于显示当前的配置状态
    current_key_display = fields.Char(
        string="Current API Key",
        compute='_compute_current_key',
        readonly=True
    )

    def _compute_current_key(self):
        ICPSudo = self.env['ir.config_parameter'].sudo()
        key = ICPSudo.get_param('gemini.api.key')
        if not key and os.getenv('GEMINI_API_KEY'):
             self.current_key_display = 'Configured (via Env Var)'
        elif not key and not os.getenv('GEMINI_API_KEY'):
             self.current_key_display = 'Configured (Hardcoded)'
        else:
             self.current_key_display = 'Configured (Encrypted)' if key else 'Not Configured'


    def save_configuration(self):
        """ 将配置保存到系统参数中，实际应用中建议使用 ir.config_parameter 存储敏感信息 """
        if not self.gemini_api_key:
            raise UserError(_("Please provide a valid Gemini API Key."))
            
        self.env['ir.config_parameter'].sudo().set_param(
            'gemini.api.key', 
            self.gemini_api_key
        )
        return {
            'type': 'ir.actions.client',
            'tag': 'display_notification',
            'params': {
                'title': _('Success'),
                'message': _('Gemini API Key saved successfully!'),
                'sticky': False,
            }
        }

class GeminiChatHistory(models.Model):
    _name = 'gemini.chat.history'
    _description = 'Gemini Chat History'
    _order = 'create_date desc'

    user_id = fields.Many2one('res.users', string="User", default=lambda self: self.env.user, required=True)
    prompt = fields.Text(string="User Prompt", required=True)
    response = fields.Text(string="Gemini Response")
    model_name = fields.Char(string="Model Used", default='gemini-2.5-flash')
    request_time = fields.Float(string="Response Time (s)")
    is_successful = fields.Boolean(string="Successful Request", default=True)

    @api.model
    def action_gemini_chat(self, prompt, model_name='gemini-2.5-flash'):
        """ 处理前端发送的消息，调用 Gemini API，并记录历史 """
        try:
            from google import genai
            from google.genai import types
            from google.genai.errors import APIError
        except ImportError:
            return {'error': "The 'google-genai' library is not installed on the server."}
        
        import time
        start_time = time.time()
        ICPSudo = self.env['ir.config_parameter'].sudo()
        api_key = ICPSudo.get_param('gemini.api.key')
        
        # Fallback to environment variable
        if not api_key:
            api_key = os.getenv('GEMINI_API_KEY')
        
        # Fallback to Hardcoded Key
        if not api_key:
            api_key = "AIzaSyDHzA3RSNhk2hr316DSD3R2JC4hXIXNjLE"

        if not api_key:
            return {'error': "Gemini API Key is not configured. Please contact the administrator."}

        # 1. 初始化 Gemini 客户端
        try:
            client = genai.Client(api_key=api_key)
        except Exception as e:
            return {'error': f"Failed to initialize Gemini client: {str(e)}"}
            
        gemini_response = ""
        is_successful = False
        
        try:
            # 2. 调用生成 API
            config = types.GenerateContentConfig(
                system_instruction="You are an helpful and friendly AI assistant integrated into an Odoo ERP system. Be concise and accurate."
            )
            response = client.models.generate_content(
                model=model_name,
                contents=[prompt],
                config=config,
            )
            gemini_response = response.text
            is_successful = True
            
        except APIError as e:
            gemini_response = f"Gemini API Error: {str(e)}"
        except Exception as e:
            gemini_response = f"An unexpected error occurred: {str(e)}"
            
        end_time = time.time()
        
        # 3. 记录对话历史
        self.create({
            'user_id': self.env.user.id,
            'prompt': prompt,
            'response': gemini_response,
            'model_name': model_name,
            'request_time': end_time - start_time,
            'is_successful': is_successful,
        })
        
        # 4. 返回结果给前端
        return {
            'response': gemini_response,
            'successful': is_successful
        }