<odoo>
    <!-- Chat Session List -->
    <record id="view_gov_chat_session_list" model="ir.ui.view">
        <field name="name">gov.chat.session.list</field>
        <field name="model">gov.chat.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Chat Session Form -->
    <record id="view_gov_chat_session_form" model="ir.ui.view">
        <field name="name">gov.chat.session.form</field>
        <field name="model">gov.chat.session</field>
        <field name="arch" type="xml">
            <form string="Gov Chat Session">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>

                    <group string="对话记录">
                        <field name="message_ids" widget="one2many_list">
                            <list>
                                <field name="user_id"/>
                                <field name="content"/>
                                <field name="is_bot"/>
                                <field name="create_date"/>
                            </list>
                        </field>
                    </group>

                    <!-- 改为安全挂载点 -->
                    <div id="gov_chat_interface_mount" class="oe_chatter"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gov_chat_session" model="ir.actions.act_window">
        <field name="name">Gov Chat</field>
        <field name="res_model">gov.chat.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
